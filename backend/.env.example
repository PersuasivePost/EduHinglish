# Copy to backend/.env and fill in.
# URL printed by training/colab_notebooks/07_colab_model_server.ipynb (changes every session unless you use an ngrok static domain)
MODEL_SERVER_URL=https://your-tunnel.trycloudflare.com
# Same value as the MODEL_API_KEY secret in Colab
MODEL_API_KEY=change-me-to-a-long-random-string
MODEL_TIMEOUT_SEC=180
# Frontend origins allowed to call the backend, comma-separated (* = any)
ALLOWED_ORIGINS=*
# PostgreSQL (Neon/Supabase) connection string. Set this on Render; leave empty locally to use SQLite.
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# SQLite file for chat history + feedback (default: backend/data/eduhinglish.db)
# DB_PATH=backend/data/eduhinglish.db

# ── Google sign-in (leave GOOGLE_CLIENT_IDS empty for local testing: no login, one shared "local user") ──
# Create an OAuth *Web application* client in Google Cloud Console -> APIs & Services -> Credentials.
# Authorized JavaScript origins: http://localhost:<port> (dev) and your Vercel URL. For Android also create an
# "Android" OAuth client (package name + SHA-1); the Web client id below is still the one the app uses.
# GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com
# Required once GOOGLE_CLIENT_IDS is set. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET=
# SESSION_DAYS=30
