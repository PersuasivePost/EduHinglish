# Copy to backend/.env and fill in.
# URL printed by training/colab_notebooks/07_colab_model_server.ipynb (changes every session unless you use an ngrok static domain)
MODEL_SERVER_URL=https://your-tunnel.trycloudflare.com
# Same value as the MODEL_API_KEY secret in Colab
MODEL_API_KEY=change-me-to-a-long-random-string
MODEL_TIMEOUT_SEC=180
# Frontend origins allowed to call the backend, comma-separated (* = any)
ALLOWED_ORIGINS=*
